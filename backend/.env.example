GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.7-flash
# 通义千问视觉模型（阿里云百炼 DashScope）：https://bailian.console.aliyun.com 获取 API Key
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max
# DeepSeek 视觉模型：https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
# OpenRouter（可调用多个模型）：https://openrouter.ai/keys 获取 API Key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_GPT_MODEL=openai/gpt-5.6-sol
PORT=3001
